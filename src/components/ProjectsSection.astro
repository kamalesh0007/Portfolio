---
import { portfolioData } from '../data/portfolioData';
import { GithubIcon } from './icons/SocialIcons';
import { ExternalLink, Layers, CheckCircle2, ArrowRight } from 'lucide-react';
---

<section id="projects" class="scroll-mt-24 py-28 relative border-t border-[#D1E8E2]/10 overflow-hidden">
  {/* Ambient background glow */}
  <div
    class="absolute bottom-0 left-10 w-[500px] h-[400px] bg-[#116466]/10 blur-[150px] pointer-events-none rounded-full"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    {/* Section Header */}
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#116466]/20 border border-[#116466]/40 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FFCB9A]"></span>
          <span class="font-mono text-xs uppercase tracking-widest text-[#FFCB9A]">03 // FEATURED WORK</span>
        </div>
        <h2 class="font-sans font-bold text-3xl sm:text-4xl lg:text-5xl text-[#D1E8E2] tracking-tight leading-[1.18] mb-4">
          Crafted Systems & Intelligent Products
        </h2>
        <p class="text-[#D1E8E2]/85 text-base sm:text-lg font-normal leading-relaxed">
          Production-grade applications and experimental interfaces built with a focus on tactile performance, accessibility, and AI integration.
        </p>
      </div>

      <a
        href="https://github.com/kamalesh0007"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-mono font-medium text-[#D1E8E2] bg-[#2C3531] border border-[#D1E8E2]/20 hover:border-[#116466] hover:bg-[#116466]/20 transition-all group self-start md:self-auto"
      >
        <GithubIcon size={16} className="text-[#D1E8E2] group-hover:text-[#FFCB9A] transition-colors" />
        <span>View all on GitHub</span>
        <ArrowRight className="w-3.5 h-3.5 text-[#FFCB9A] group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

    {/* Project Cards Stack */}
    <div class="space-y-8">
      {portfolioData.projects.map((project, idx) => (
        <div class="p-8 sm:p-10 rounded-2xl bg-[#2C3531]/95 border border-[#D1E8E2]/15 hover:border-[#116466] shadow-2xl shadow-black/30 transition-all duration-300 group">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            {/* Left: Project Details & Narrative */}
            <div class="lg:col-span-8 flex flex-col justify-between">
              <div>
                <div class="flex flex-wrap items-center gap-3 mb-3">
                  <span class="font-mono text-xs font-semibold text-[#FFCB9A] tracking-wider uppercase">
                    SYSTEM // 0{idx + 1}
                  </span>
                  <span class="text-[#D1E8E2]/20">•</span>
                  <span class="font-mono text-xs text-[#D9B08C]">
                    {project.subtitle}
                  </span>
                </div>

                <h3 class="font-sans font-bold text-2xl sm:text-3xl text-[#D1E8E2] group-hover:text-[#FFCB9A] transition-colors mb-4">
                  {project.title}
                </h3>

                <p class="text-base text-[#D1E8E2]/80 leading-relaxed font-light mb-6">
                  {project.description}
                </p>

                {/* Tech Stack Pills */}
                <div class="flex flex-wrap gap-2 mb-6">
                  {project.techStack.map((tech) => (
                    <span class="px-3 py-1 rounded-lg text-xs font-mono font-medium bg-[#242c29] border border-[#D1E8E2]/10 text-[#D1E8E2]">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              {/* Actions & Links */}
              <div class="flex items-center gap-4 pt-4 border-t border-[#D1E8E2]/10">
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-mono font-medium text-[#D1E8E2] bg-[#116466]/30 hover:bg-[#116466] border border-[#116466] transition-all group/btn"
                >
                  <GithubIcon size={14} className="text-[#FFCB9A]" />
                  <span>Repository</span>
                </a>
              </div>
            </div>

            {/* Right: Technical Metrics & Spec Box */}
            <div class="lg:col-span-4 p-6 rounded-xl bg-[#242c29]/90 border border-[#D1E8E2]/10 space-y-4">
              <div class="flex items-center gap-2 font-mono text-xs text-[#FFCB9A] uppercase tracking-wider pb-2 border-b border-[#D1E8E2]/10">
                <Layers className="w-4 h-4 text-[#116466]" />
                <span>Architecture Metrics</span>
              </div>

              <div class="space-y-3">
                {project.metrics.map((metric) => (
                  <div class="flex items-center gap-2.5 text-xs font-mono text-[#D1E8E2]/90">
                    <CheckCircle2 className="w-3.5 h-3.5 text-[#116466] flex-shrink-0" />
                    <span>{metric}</span>
                  </div>
                ))}
              </div>

              <div class="pt-3 border-t border-[#D1E8E2]/10 flex items-center justify-between text-[11px] font-mono text-[#D9B08C]/80">
                <span>STATUS: VERIFIED</span>
                <span>CORE_VITALS: 100</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
