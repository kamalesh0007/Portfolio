---
import { portfolioData } from '../data/portfolioData';
---

<section id="about" class="scroll-mt-24 py-28 relative border-t border-[#D1E8E2]/10 overflow-hidden">
  {/* Ambient background glow */}
  <div
    class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-[#116466]/10 blur-[130px] pointer-events-none rounded-full"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    {/* Section Header */}
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#116466]/20 border border-[#116466]/40 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#FFCB9A]"></span>
        <span class="font-mono text-xs uppercase tracking-widest text-[#FFCB9A]">01 // ABOUT</span>
      </div>
      <h2 class="font-sans font-bold text-3xl sm:text-4xl lg:text-5xl text-[#D1E8E2] tracking-tight leading-[1.18] mb-6">
        {portfolioData.about.title}
      </h2>
      <p class="text-[#D1E8E2]/90 text-lg sm:text-xl font-normal leading-relaxed">
        {portfolioData.about.lead}
      </p>
    </div>

    {/* Narrative & Principles Grid */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-16">
      {/* Left Column: Narrative Paragraphs */}
      <div class="lg:col-span-6 space-y-5 text-base sm:text-lg text-[#D1E8E2]/80 leading-relaxed font-light">
        {portfolioData.about.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>

      {/* Right Column: Architectural Principles Cards */}
      <div class="lg:col-span-6 space-y-4">
        {portfolioData.about.principles.map((principle, idx) => (
          <div class="p-6 rounded-2xl bg-[#2C3531]/90 border border-[#D1E8E2]/10 hover:border-[#116466] hover:bg-[#116466]/10 transition-all duration-300 group shadow-lg shadow-black/20">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-sans font-semibold text-lg text-[#D1E8E2] group-hover:text-[#FFCB9A] transition-colors">
                {principle.title}
              </h3>
              <span class="font-mono text-xs text-[#D9B08C] px-2.5 py-0.5 rounded-full bg-[#2C3531] border border-[#D9B08C]/30">
                {principle.tag}
              </span>
            </div>
            <p class="text-sm text-[#D1E8E2]/70 leading-relaxed">
              {principle.description}
            </p>
          </div>
        ))}
      </div>
    </div>

    {/* Metric Highlights Grid */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-4">
      {portfolioData.about.stats.map((stat) => (
        <div class="p-5 sm:p-6 rounded-2xl bg-[#242c29]/80 border border-[#D1E8E2]/10 backdrop-blur-sm flex flex-col justify-between">
          <div class="font-mono font-extrabold text-2xl sm:text-3xl text-[#FFCB9A] mb-1">
            {stat.value}
          </div>
          <div class="font-sans font-semibold text-sm text-[#D1E8E2] mb-0.5">
            {stat.label}
          </div>
          <div class="font-mono text-xs text-[#D1E8E2]/50">
            {stat.subtext}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
