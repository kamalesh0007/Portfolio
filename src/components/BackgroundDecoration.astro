---
// Pure CSS/SVG Background Decoration with radial mask for ultra-lightweight performance
---

<div class="absolute inset-0 overflow-hidden pointer-events-none select-none z-0" aria-hidden="true">
  {/* Subtle Ambient Radial Lighting */}
  <div
    class="absolute top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full bg-[#116466]/15 blur-[120px]"
  ></div>
  <div
    class="absolute top-1/3 right-1/4 translate-x-1/4 -translate-y-1/2 w-[450px] h-[450px] rounded-full bg-[#116466]/10 blur-[140px]"
  ></div>
  <div
    class="absolute bottom-10 left-1/3 w-[350px] h-[350px] rounded-full bg-[#D9B08C]/5 blur-[100px]"
  ></div>

  {/* Subtle Grid Pattern masked with a radial vignette */}
  <div
    class="absolute inset-0 bg-grid-pattern opacity-60 [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)]"
  ></div>

  {/* Subtle Architectural Corner Accents */}
  <div class="absolute top-24 left-6 sm:left-12 text-[#D1E8E2]/15 font-mono text-xs hidden lg:block">
    +
  </div>
  <div class="absolute top-24 right-6 sm:right-12 text-[#D1E8E2]/15 font-mono text-xs hidden lg:block">
    +
  </div>
  <div class="absolute bottom-12 left-6 sm:left-12 text-[#D1E8E2]/15 font-mono text-xs hidden lg:block">
    +
  </div>
  <div class="absolute bottom-12 right-6 sm:right-12 text-[#D1E8E2]/15 font-mono text-xs hidden lg:block">
    +
  </div>
</div>
