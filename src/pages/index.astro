---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import AboutSection from '../components/AboutSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import { ContactSection } from '../components/ContactSection';
import Footer from '../components/Footer.astro';
---

<Layout 
	title="Kamalesh | Frontend Architect & AI Engineer"
	description="Portfolio of Kamalesh, Fullstack Frontend Architect and AI Specialist building digital experiences with code and intelligence."
>
	{/* Hero Section */}
	<HeroSection />

	{/* 01 // About Section */}
	<AboutSection />

	{/* 02 // Skills & Capabilities Section */}
	<SkillsSection />

	{/* 03 // Projects & Engineering Work */}
	<ProjectsSection />

	{/* 04 // Contact & Inquiry Section */}
	<ContactSection client:visible />

	{/* Footer */}
	<Footer />
</Layout>
